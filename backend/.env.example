# Django Core Settings
SECRET_KEY=fraudshield-insecure-dev-secret-key-change-in-production-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (defaults to SQLite if DATABASE_URL is empty)
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://fraudshield:fraudshield@localhost:5432/fraudshield_db

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Lifetimes (minutes / days)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Machine Learning Artifacts Directory
ML_DIR=../ml
